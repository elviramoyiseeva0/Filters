@model IEnumerable<TodoList.Models.TaskItem>

@{
    ViewData["Title"] = "Todo List";
}

<div class="text-center">
    <h1 class="display-4">Todo List</h1>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <h3>Add Task</h3>
        <form asp-action="Create" method="post">
            <div class="form-group mb-3">
                <label>Title</label>
                <input type="text" name="Title" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </div>

    <div class="col-md-8">
        <h3>Task List</h3>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Updated</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td>@task.Id</td>
                        <td>@task.Title</td>
                        <td>@task.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            <form asp-action="Update" method="post" style="display:inline;">
                                <input type="hidden" name="Id" value="@task.Id" />
                                <input type="text" name="Title" value="@task.Title" style="width: 120px;" required />
                                <button type="submit" class="btn btn-sm btn-success">Update</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>